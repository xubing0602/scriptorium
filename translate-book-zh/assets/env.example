# Copy to <project>/.env and paste your API key. Two ready-made setups:

# --- DeepSeek (OpenAI-compatible), no thinking ---
PROVIDER=openai
API_KEY=sk-...
BASE_URL=https://api.deepseek.com
MODEL=deepseek-flash
THINKING=off
# DeepSeek charges half price 16:30-00:30 UTC (Beijing 00:30-08:30)
TEMPERATURE=1.0

# --- Claude ---
# PROVIDER=anthropic
# API_KEY=sk-ant-...
# MODEL=claude-opus-5
# THINKING=on
# EFFORT=high

CONCURRENCY=3
CHUNK_WORDS=1200
# GLOSSARY_MODE=relevant   # or full: whole glossary in the (cached) system prompt

# Default book when a script is run without --book (a directory under books/)
# BOOK=my-book
